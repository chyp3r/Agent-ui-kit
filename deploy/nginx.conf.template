# Serves the built starter and forwards /api/ to the backend, so the browser only ever
# talks to its own origin and the backend needs no CORS.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: unknown paths fall back to the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # Saving a session posts the whole conversation: nginx's default 1 MB would stop
        # saves after a few long turns.
        client_max_body_size 50m;
        # Docker's DNS, asked at request time: a literal host would be resolved once at
        # startup, so nginx would not start before the backend and would keep its old
        # address after a restart. With a variable the URI is passed on as it came.
        resolver 127.0.0.11 valid=10s;
        set $backend ${API_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A run writes one line per event: pass each through as it is written.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        # A run can take minutes with a slow model, and the report streams on top of that.
        proxy_read_timeout 1800s;
    }
}
